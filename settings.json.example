{
  "_comment": "Merge these keys into ~/.claude/settings.json. Do not replace the file; it holds your own permissions and MCP configuration. Every key here is optional.",

  "_comment_hooks": "Installed by `rtk init -g --hook-only` (rtk 1.x), shown here so the wiring is legible. Rewrites Bash commands to their filtered equivalent before they run. rtk 0.x used a ~/.claude/hooks/rtk-rewrite.sh script instead, which does not work with 1.x.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },

  "_comment_env": "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH caps delegation depth. Without a cap, a subagent can delegate to a subagent, and the token cost of a single dispatch stops being predictable. 2 allows the main session to delegate and that agent to delegate once more.",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2"
  },

  "_comment_cleanup": "Claude Code deletes session transcripts after 30 days by default. The verify/ scripts read those transcripts, so a before/after comparison silently loses its baseline once it ages out. 90 keeps enough history to measure a change against the period before it.",
  "cleanupPeriodDays": 90,

  "_comment_effort": "Effort level applies to the main conversation. Subagents override it per definition, which is the point: the expensive setting is spent where reasoning happens and not on mechanical work. It is saved per model under modelSettings, which is what /effort writes; the top-level effortLevel key is legacy and Opus 5.5 and newer ignore it. On Opus 5.5, Sonnet 5.5, Haiku 5.5 and Fable 5.1 or later, changing effort mid-session keeps the prompt cache; on older models it invalidates it.",
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" }
  }
}
